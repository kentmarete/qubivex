{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentmarete/qubivex/docs/model-support/manifest.schema.json",
  "title": "QUBIVEX model manifest",
  "description": "manifest.json, schema v1 (ADR-004). Dimensions are read from config.json or GGUF metadata, not from here; the manifest only names files and supplies what the checkpoint does not declare.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "architecture", "weights", "tokenizer"],
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "description": "Relative to the model directory; no '..', no absolute or drive paths, no backslashes.",
      "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "(^|/)\\.\\.?(/|$)" }, { "pattern": "[\\\\:]" }] }
    }
  },
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver", "description": "This build reads 1.x." },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,128}$", "description": "Stable id used on the command line." },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "description": "A registered architecture, for example transformer_moe." },
        "version": { "$ref": "#/$defs/semver", "description": "Accepted when the major matches and the minor is not newer than the build's." },
        "config": {
          "type": "object",
          "description": "Architecture-specific options. For transformer_moe: tensor_names (\"hf\" | \"hf_fused\" | \"gguf\" | {\"base\": preset, <name>: pattern with {L} and {E}}), qk_norm (\"none\" | \"full\" | \"per_head\"), router_scoring (\"softmax\" | \"sigmoid\")."
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "shards"],
      "properties": {
        "format": { "enum": ["safetensors", "gguf"] },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/relpath" },
              "size": { "type": "integer", "minimum": 0, "description": "Checked against the file at load." },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Checked by qubivex models verify." }
            }
          }
        },
        "config": { "$ref": "#/$defs/relpath", "description": "config.json (SafeTensors only; GGUF carries its config)." }
      }
    },
    "tokenizer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": { "kind": { "const": "huggingface" }, "path": { "$ref": "#/$defs/relpath" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "gguf" } }
        }
      ]
    },
    "context_length": { "type": "integer", "minimum": 1, "description": "A lower limit than the architecture's." },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "quantization": { "type": "string", "description": "Display label, for example Q4_K_M." },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "description": "Values missing from config.json or GGUF metadata, by config.json name. A value the checkpoint also states must agree with it."
        },
        "ignore_tensors": { "type": "array", "items": { "type": "string" }, "description": "Tensors present but unused." }
      }
    }
  }
}
