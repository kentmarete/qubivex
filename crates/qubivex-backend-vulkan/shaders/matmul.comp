// QUBIVEX Vulkan matmul (ADR-019): ys[t] = W · xs[t] with the CPU backend's bits.
//
// Compile with `shaders/build.sh`; the SPIR-V is checked in as `src/matmul.spv`
// so building the crate needs no shader compiler.
//
// Every output reproduces what `qubivex-backend-cpu` computes:
// - each weight has the value `formats::dequant_row` gives it: the same operations in
//   the same order, f16 converted by integer bit manipulation (exact, subnormals
//   included), and every multiply and subtract a separate rounded operation;
// - the dot product uses the CPU's reduction shape (`reduce::dot`): 64 f32 lanes, one
//   fused multiply-add per lane per 64-element chunk in increasing k, a final partial
//   chunk in lanes 0..rem, then the halving tree a[i] += a[i + w] for w = 32, 16, 8, 4,
//   then (a0 + a1) + (a2 + a3).
//
// Contraction: only the explicit `fma` calls are fused. `build.sh` decorates every
// floating-point add, subtract and `fma` with NoContraction, so no driver may fuse a
// multiply into the add or subtract that consumes it, or split an fma into two
// roundings (lavapipe does even so: ADR-019). Multiplies are left undecorated: the
// shader uses `precise` nowhere, because SPIRV-Cross (MoltenVK) turns each
// NoContraction operation into a call to an unoptimised helper, which made the
// kernel several times slower when every multiply was decorated.
//
// One group of 32 invocations computes one output: invocation `lane` holds lanes `lane`
// and `lane + 32`, so the w = 32 step is a per-invocation add. The rest of the tree goes
// through shared memory with barriers, not subgroup shuffles, so the result does not
// depend on the driver's subgroup size (MoltenVK has 32, lavapipe 4 to 16).
//
// The weight dtype is a specialization constant, so one module gives six pipelines.

#version 450

layout(local_size_x = 256) in;

// Output rows per workgroup: 256 invocations / 32 per row.
const uint ROWS = 8;

#define MATMUL_PARAMS                                                              \
    layout(push_constant) uniform Params {                                         \
        uint n;         /* output rows */                                          \
        uint k;         /* input columns */                                        \
        uint row_bytes; /* bytes per weight row */                                 \
        uint w_base;    /* byte offset of row 0 in the bound weight range */       \
        uint x_base;    /* float offset of activation row 0 */                     \
        uint y_base;    /* float offset of output row 0 */                         \
    } p;
#define P_N p.n
#define P_K p.k
#define P_ROW_BYTES p.row_bytes
#define P_W_BASE p.w_base
#define P_X_BASE p.x_base
#define P_Y_BASE p.y_base
#define ROW_BLOCK gl_WorkGroupID.x
#define TOKEN gl_WorkGroupID.y
#define MATMUL_PROLOGUE

#include "matmul_body.glsl"
