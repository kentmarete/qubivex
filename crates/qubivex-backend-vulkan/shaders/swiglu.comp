// QUBIVEX Vulkan SwiGLU (audit §15.1): v[g + i] = silu(v[g + i]) * v[u + i] for
// i < n, with the CPU's bits: silu(a) = a / (1 + exp(-a)) exactly as
// `qubivex_compute::math::swiglu`, and exp the port of `qubivex_compute::math::exp`
// (basic operations and fma only, in the same order).
//
// Built with `glslc -O0`, never -O (build.sh): -O folds exp's rounding step
// `(x * LOG2E + SHIFT) - SHIFT` before build.sh can mark it NoContraction, so `int(kf)`
// truncates instead of rounding and ordinary values come out 1 ulp off (audit §15.1:
// 472 million of 2^32 inputs differ at -O, none at -O0). Then every add, subtract and fma
// is NoContraction, as in matmul.comp; multiplies and the division are left alone. The
// division must be correctly rounded: the parity tests check it on the device.
//
// The gate and up values sit in one buffer (the expert block's intermediates), at word
// offsets `g` and `u`; binding 2 is the layout shared with matmul_fused.comp.
#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 2) buffer V {
    float v[];
};

layout(push_constant) uniform Params {
    uint n;
    uint g;
    uint u;
    uint unused;
} p;

// `qubivex_compute::math` constants, as bit patterns.
const float LOG2E = uintBitsToFloat(0x3fb8aa3bu);
const float LN2_HI = uintBitsToFloat(0x3f317200u);
const float LN2_LO = uintBitsToFloat(0x35bfbe8eu);
const float SHIFT = uintBitsToFloat(0x4b400000u);
const float OVERFLOW = uintBitsToFloat(0x42b17218u);
const float UNDERFLOW = uintBitsToFloat(0xc2aeac50u);
const float MIN_POSITIVE = uintBitsToFloat(0x00800000u);
const float INF = uintBitsToFloat(0x7f800000u);

float pow2(int k) {
    return intBitsToFloat((k + 127) << 23);
}

float qexp(float x) {
    if (isnan(x)) {
        return x;
    }
    if (x > OVERFLOW) {
        return INF;
    }
    if (x < UNDERFLOW) {
        return 0.0;
    }
    float kf = (x * LOG2E + SHIFT) - SHIFT;
    float r = fma(-kf, LN2_HI, x);
    r = fma(-kf, LN2_LO, r);
    float q = uintBitsToFloat(0x39506967u);
    q = fma(q, r, uintBitsToFloat(0x3ab743ceu));
    q = fma(q, r, uintBitsToFloat(0x3c088908u));
    q = fma(q, r, uintBitsToFloat(0x3d2aa9c1u));
    q = fma(q, r, uintBitsToFloat(0x3e2aaaaau));
    q = fma(q, r, uintBitsToFloat(0x3f000000u));
    float y = fma(q, r * r, r) + 1.0;
    int k = int(kf);
    int k1 = k >> 1;
    float s = (y * pow2(k1)) * pow2(k - k1);
    return s < MIN_POSITIVE ? 0.0 : s;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    float a = v[p.g + i];
    float s = a / (1.0 + qexp(-a));
    v[p.g + i] = s * v[p.u + i];
}
