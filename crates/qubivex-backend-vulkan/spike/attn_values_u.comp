// Values, unrolled: as attn_values.comp (the same fma chain in the same order), with
// eight positions' loads issued before their eight fmas, so the loads overlap.
#version 450
layout(local_size_x = 64) in;
#include "attn_split.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint h = gl_WorkGroupID.y;
    uint t = gl_WorkGroupID.z;
    uint s = gl_NumWorkGroups.z;
    uint span = p.p0 + s;
    uint d = D;
    if (i >= d) {
        return;
    }
    uint n = p.p0 + t + 1u;
    uint g = h / GROUP;
    uint stride = KVH * d;
    uint sb = (t * HEADS + h) * span;
    uint vb = p.v_base + g * d + i;
    float o = 0.0;
    uint j = 0u;
    for (; j + 8u <= n; j += 8u) {
        float v0 = kv[vb + j * stride];
        float v1 = kv[vb + (j + 1u) * stride];
        float v2 = kv[vb + (j + 2u) * stride];
        float v3 = kv[vb + (j + 3u) * stride];
        float v4 = kv[vb + (j + 4u) * stride];
        float v5 = kv[vb + (j + 5u) * stride];
        float v6 = kv[vb + (j + 6u) * stride];
        float v7 = kv[vb + (j + 7u) * stride];
        vec4 pa = vec4(sc[sb + j], sc[sb + j + 1u], sc[sb + j + 2u], sc[sb + j + 3u]);
        vec4 pb = vec4(sc[sb + j + 4u], sc[sb + j + 5u], sc[sb + j + 6u], sc[sb + j + 7u]);
        o = fma(pa.x, v0, o);
        o = fma(pa.y, v1, o);
        o = fma(pa.z, v2, o);
        o = fma(pa.w, v3, o);
        o = fma(pb.x, v4, o);
        o = fma(pb.y, v5, o);
        o = fma(pb.z, v6, o);
        o = fma(pb.w, v7, o);
    }
    for (; j < n; j++) {
        o = fma(sc[sb + j], kv[vb + j * stride], o);
    }
    out_[(t * HEADS + h) * d + i] = o;
}
