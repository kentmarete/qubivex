// Softmax, unrolled: as attn_softmax.comp, the sequential sum reading eight values
// before adding them in order. Softmax over each (token, head)'s visible scores, in place: a NaN-ignoring tree
// maximum, exp(v - m) in parallel, the sum sequential from +0 in one invocation, one
// division each in parallel. Grid: (heads, tokens).
#version 450
layout(local_size_x = 128) in;
#include "attn_split.glsl"
const uint LOCAL = 128u;
shared float red[LOCAL];
shared float stot;
#include "exp.glsl"
float fmax_rust(float a, float b) {
    return isnan(a) ? b : (isnan(b) ? a : max(a, b));
}
void main() {
    uint h = gl_WorkGroupID.x;
    uint t = gl_WorkGroupID.y;
    uint s = gl_NumWorkGroups.y;
    uint span = p.p0 + s;
    uint n = p.p0 + t + 1u;
    uint l = gl_LocalInvocationID.x;
    uint sb = (t * HEADS + h) * span;
    float m = uintBitsToFloat(0xff800000u);
    for (uint j = l; j < n; j += LOCAL) {
        m = fmax_rust(m, sc[sb + j]);
    }
    red[l] = m;
    memoryBarrierShared();
    barrier();
    for (uint w = LOCAL / 2u; w > 0u; w /= 2u) {
        float v = 0.0;
        if (l < w) {
            v = fmax_rust(red[l], red[l + w]);
        }
        memoryBarrierShared();
        barrier();
        if (l < w) {
            red[l] = v;
        }
        memoryBarrierShared();
        barrier();
    }
    m = red[0];
    for (uint j = l; j < n; j += LOCAL) {
        sc[sb + j] = qexp(sc[sb + j] - m);
    }
    memoryBarrierBuffer();
    barrier();
    if (l == 0u) {
        float sum = 0.0;
        uint j = 0u;
        for (; j + 8u <= n; j += 8u) {
            vec4 a = vec4(sc[sb + j], sc[sb + j + 1u], sc[sb + j + 2u], sc[sb + j + 3u]);
            vec4 b = vec4(sc[sb + j + 4u], sc[sb + j + 5u], sc[sb + j + 6u], sc[sb + j + 7u]);
            sum += a.x;
            sum += a.y;
            sum += a.z;
            sum += a.w;
            sum += b.x;
            sum += b.y;
            sum += b.z;
            sum += b.w;
        }
        for (; j < n; j++) {
            sum += sc[sb + j];
        }
        stot = sum;
    }
    memoryBarrierShared();
    barrier();
    float sum = stot;
    for (uint j = l; j < n; j += LOCAL) {
        sc[sb + j] = sc[sb + j] / sum;
    }
}
